{
  "manifest_version": 3,
  "name": "时间戳转换",
  "version": "1.0.0",
  "description": "在浏览器任意页面将时间戳与日期互相转换（年月日 时:分:秒.毫秒），支持右键选中一键转换。",
  "permissions": ["contextMenus", "scripting", "activeTab", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "时间戳转换",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
